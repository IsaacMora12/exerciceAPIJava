# Deploy completo: ./scripts/deploy.sh — bootstrap de Garage + up + seed one-shot
POSTGRES_DB = exercise_db
POSTGRES_USERNAME = postgres
POSTGRES_PASSWORD = ***
# Host:contenedor de Postgres. Dev usa 5434 porque el PG del sistema ocupa la
# 5432 del host; en producción: POSTGRES_HOST_PORT = 5432
POSTGRES_HOST_PORT = 5434
GARAGE_ACCESS_KEY = ***
GARAGE_SECRET_KEY = ***
# JWT_SECRET: base64 válido (≥32 bytes decodificados) O texto crudo ≥32 chars;
# JwtService valida la longitud al arrancar (fail-fast). Generá uno:
#   openssl rand -base64 48
JWT_SECRET = ***
# Perfil de Spring activo en el contenedor (dev | garage | prod).
#   garage -> GarageFileStorageService (S3/Garage) — REQUERIDO en Docker: el seed
#             sube los assets a Garage, si la app corre con 'dev' intenta servirlos
#             del disco local (que esta vacio) y devuelve /media/... rotos.
#   dev    -> LocalFileStorageService (disco local) — solo sin Docker.
SPRING_PROFILES_ACTIVE = garage
# Endpoint de Garage tal como lo ve el contenedor de la app. En Docker el
# default ya es http://garage:3900 (servicio en la red de compose) y NO hace
# falta setearlo; solo si corrés la app FUERA de docker usarías
# http://localhost:3900 (puerto publicado de garage).
GARAGE_ENDPOINT = http://garage:3900
# Cómo getUrl() expone los objetos de Garage: presigned (default; firma con
# expiración) | public (solo sirve contra S3/MinIO con acceso anónimo habilitado;
# Garage v2.x lo rechaza con 403 en el endpoint S3)
GARAGE_URL_MODE = presigned
# Como GARAGE_ENDPOINT pero del lado del CLIENTE: las URLs firmadas se firman
# contra este host, tiene que ser resoluble desde la máquina del browser.
# Cambiala solo si los clientes NO llegan a Garage por http://localhost:3900
# (p.ej. Garage expuesto en otra IP/puerto o atrás de un reverse proxy).
GARAGE_PUBLIC_ENDPOINT = http://localhost:3900
